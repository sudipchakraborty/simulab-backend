# Account API configuration template. Set environment variables explicitly; no dotenv loader is installed.
ACCOUNT_PORT=4320
ACCOUNT_HOST=127.0.0.1
ACCOUNT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_URL=http://localhost:5173
ACCOUNT_DB=.local/accounts.sqlite
ACCOUNT_SYSTEM_CONFIG=.local/SYSTEM.json
ACCOUNT_TRIAL_DAYS=30
ACCOUNT_SECURE_COOKIES=false
# Explicit development transport only; remove when using SMTP.
# ACCOUNT_DEV_OUTBOX=.local/mail-outbox
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_TLS=false
# SMTP_FROM=
# SMTP_USER=
# SMTP_PASSWORD=
# PAYMENT_AMOUNT_MINOR=
# PAYMENT_CURRENCY=
# PAYMENT_QR_IMAGE=
# PAYMENT_WEBHOOK_SECRET=
# PAYMENT_PAID_DAYS=30
# ACCOUNT_BOOTSTRAP_ADMIN=verified-operator@example.com
